#!/bin/sh
# S-Horizon CI network namespace setup (idempotent).
# The CI dockerd and containerd run inside netns shz-ci (their units carry
# NetworkNamespacePath drop-ins), so their netfilter lifecycle never touches
# the host tables. The host only carries this transit: a /30 veth pair, a
# scoped return route, and three shz-ci-gw-tagged firewall rules.
set -eu
ip netns list | awk '{print $1}' | grep -qx shz-ci || ip netns add shz-ci
ip -n shz-ci link set lo up
if ! ip -n shz-ci link show shz-br0 >/dev/null 2>&1; then
  ip -n shz-ci link add shz-br0 type bridge
  ip -n shz-ci addr add 10.199.0.1/16 dev shz-br0
fi
ip -n shz-ci link set shz-br0 up
if ! ip link show veth-ci-h >/dev/null 2>&1; then
  ip link add veth-ci-h type veth peer name veth-ci-c netns shz-ci
fi
if ! ip -4 addr show dev veth-ci-h | grep -q inet; then
  ip addr add 10.200.0.1/30 dev veth-ci-h
fi
ip link set veth-ci-h up
if ! ip -n shz-ci -4 addr show dev veth-ci-c | grep -q inet; then
  ip -n shz-ci addr add 10.200.0.2/30 dev veth-ci-c
fi
ip -n shz-ci link set veth-ci-c up
ip netns exec shz-ci sysctl -qw net.ipv4.ip_forward=1
ip -n shz-ci route replace default via 10.200.0.1
ip route replace 10.199.0.0/16 via 10.200.0.2 dev veth-ci-h
iptables -C DOCKER-USER -i veth-ci-h -s 10.200.0.0/30 -m comment --comment shz-ci-gw -j ACCEPT 2>/dev/null || iptables -I DOCKER-USER 1 -i veth-ci-h -s 10.200.0.0/30 -m comment --comment shz-ci-gw -j ACCEPT
iptables -C DOCKER-USER -o veth-ci-h -d 10.200.0.0/30 -m conntrack --ctstate ESTABLISHED,RELATED -m comment --comment shz-ci-gw -j ACCEPT 2>/dev/null || iptables -I DOCKER-USER 1 -o veth-ci-h -d 10.200.0.0/30 -m conntrack --ctstate ESTABLISHED,RELATED -m comment --comment shz-ci-gw -j ACCEPT
WAN_IF=$(ip route show default | awk '{print $5; exit}')
[ -n "$WAN_IF" ] || { echo "no default route; cannot install masquerade" >&2; exit 1; }
iptables -t nat -C POSTROUTING -s 10.200.0.0/30 -o "$WAN_IF" -m comment --comment shz-ci-gw -j MASQUERADE 2>/dev/null || iptables -t nat -I POSTROUTING 1 -s 10.200.0.0/30 -o "$WAN_IF" -m comment --comment shz-ci-gw -j MASQUERADE
