[Unit]
Description=S-Horizon CI netns DNS forwarder at 127.0.0.53 inside shz-ci
After=shz-ci-netns.service
Before=shz-ci-containerd.service shz-ci-docker.service
Requires=shz-ci-netns.service

[Service]
ExecStart=/usr/sbin/ip netns exec shz-ci /usr/sbin/dnsmasq --no-daemon --keep-in-foreground --interface=lo --bind-interfaces --listen-address=127.0.0.53 --port=53 --no-resolv --no-hosts --server=223.5.5.5 --server=114.114.114.114 --max-cache-ttl=300
Restart=on-failure

[Install]
WantedBy=multi-user.target
